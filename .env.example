# Copier ce fichier en ".env" à la racine avant de lancer `docker compose up`.
# Ce fichier est lu par docker-compose.yml (variables ${...}) et ne doit
# jamais être commité avec de vraies valeurs (.env est déjà dans .gitignore).

# --- Base de données MySQL ---
DB_ROOT_PASSWORD=changeme
DB_NAME=my_music
DB_USER=my_music
DB_PASSWORD=changeme

# --- Microservice mail (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=password
SMTP_FROM_NAME=My Music
SMTP_FROM_EMAIL=no-reply@my-music.app

# --- Microservice upload autonome (optionnel) ---
UPLOAD_BASE_URL=http://localhost:4002
